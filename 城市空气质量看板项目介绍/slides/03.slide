<Slide style={{ padding: '20px 70px', background: '#F4F9FA' }}>
    <Box style={{ height: '110px', justifyContent: 'center' }}>
        <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#0E7490', lineHeight: 1.3 }}>数据集：真实、可追溯、够充分</Text>
        <Box style={{ width: '56px', height: '4px', background: '#7FD1C6', marginTop: '12px' }} />
    </Box>

    <Box style={{ height: '510px', flexDirection: 'row', gap: '36px' }}>
        <Box style={{ width: '620px', background: '#FFFFFF', borderRadius: '14px', padding: '18px 20px', boxShadow: '0 4px 20px rgba(14,116,144,0.08)' }}>
            <Text style={{ fontSize: 18, fontWeight: '600', color: '#1F2937' }}>12 城年均 AQI（2025 全年）</Text>
            <Text style={{ fontSize: 14, color: '#94A3B8', marginTop: '4px' }}>单位：AQI，按国标六档着色</Text>
            <svg width='580' height='420' viewBox='0 0 580 420'>
                <text x='0' y='24' font-size='14' fill='#1F2937'>深圳</text>
                <rect x='52' y='12' width='230' height='18' rx='4' fill='#4CAF50' />
                <text x='290' y='25' font-size='13' fill='#64748B'>40.8</text>

                <text x='0' y='58' font-size='14' fill='#1F2937'>海口</text>
                <rect x='52' y='46' width='245' height='18' rx='4' fill='#4CAF50' />
                <text x='305' y='59' font-size='13' fill='#64748B'>43.4</text>

                <text x='0' y='92' font-size='14' fill='#1F2937'>广州</text>
                <rect x='52' y='80' width='269' height='18' rx='4' fill='#4CAF50' />
                <text x='329' y='93' font-size='13' fill='#64748B'>47.7</text>

                <text x='0' y='126' font-size='14' fill='#1F2937'>上海</text>
                <rect x='52' y='114' width='319' height='18' rx='4' fill='#EAB308' />
                <text x='379' y='127' font-size='13' fill='#64748B'>56.5</text>

                <text x='0' y='160' font-size='14' fill='#1F2937'>杭州</text>
                <rect x='52' y='148' width='325' height='18' rx='4' fill='#EAB308' />
                <text x='385' y='161' font-size='13' fill='#64748B'>57.5</text>

                <text x='0' y='194' font-size='14' fill='#1F2937'>北京</text>
                <rect x='52' y='182' width='342' height='18' rx='4' fill='#EAB308' />
                <text x='402' y='195' font-size='13' fill='#64748B'>60.6</text>

                <text x='0' y='228' font-size='14' fill='#1F2937'>成都</text>
                <rect x='52' y='216' width='363' height='18' rx='4' fill='#EAB308' />
                <text x='423' y='229' font-size='13' fill='#64748B'>64.3</text>

                <text x='0' y='262' font-size='14' fill='#1F2937'>哈尔滨</text>
                <rect x='52' y='250' width='370' height='18' rx='4' fill='#EAB308' />
                <text x='430' y='263' font-size='13' fill='#64748B'>65.5</text>

                <text x='0' y='296' font-size='14' fill='#1F2937'>兰州</text>
                <rect x='52' y='284' width='408' height='18' rx='4' fill='#EAB308' />
                <text x='468' y='297' font-size='13' fill='#64748B'>72.2</text>

                <text x='0' y='330' font-size='14' fill='#1F2937'>石家庄</text>
                <rect x='52' y='318' width='438' height='18' rx='4' fill='#EAB308' />
                <text x='498' y='331' font-size='13' fill='#64748B'>77.5</text>

                <text x='0' y='364' font-size='14' fill='#1F2937'>西安</text>
