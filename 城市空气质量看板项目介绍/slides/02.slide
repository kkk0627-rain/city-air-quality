<Slide style={{ padding: '20px 70px', background: '#F4F9FA' }}>
    <Box style={{ height: '110px', justifyContent: 'center' }}>
        <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#0E7490', lineHeight: 1.3 }}>项目背景与目标</Text>
        <Box style={{ width: '56px', height: '4px', background: '#7FD1C6', marginTop: '12px' }} />
    </Box>

    <Box style={{ height: '510px', flexDirection: 'row', gap: '32px' }}>
        <Box style={{ width: '330px', background: 'linear-gradient(135deg, #0E7490 0%, #7FD1C6 100%)', borderRadius: '14px', padding: '34px 30px', justifyContent: 'space-between' }}>
            <Box>
                <Text style={{ fontSize: 18, color: '#B8E6E0', fontWeight: '600', letterSpacing: 2 }}>GOAL</Text>
                <Text style={{ fontSize: 28, color: '#FFFFFF', fontWeight: 'bold', marginTop: '18px', lineHeight: 1.4 }}>我们要解决
什么</Text>
            </Box>
            <Box>
                <Text style={{ fontSize: 17, color: '#E4F5F3', lineHeight: 1.7 }}>把分散发布、口径不一的官方监测数据，变成可筛选、可对比、可追溯的一屏看板——不用翻表格，也能一眼看出哪座城市、哪段时间、哪种污染物更严重。</Text>
                <Box style={{ height: '1px', background: 'rgba(255,255,255,0.35)', marginTop: '22px', marginBottom: '18px' }} />
                <Text style={{ fontSize: 16, color: '#B8E6E0', lineHeight: 1.7 }}>交付范围：F1~F8 八项前端功能<br />A1~A4 四个后端接口</Text>
            </Box>
        </Box>

        <Box style={{ flex: 1, justifyContent: 'space-between' }}>
            <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: '24px', background: '#FFFFFF', borderRadius: '12px', padding: '0 28px', boxShadow: '0 4px 20px rgba(14,116,144,0.08)' }}>
                <svg width='56' height='56' viewBox='0 0 56 56'>
                    <rect x='6' y='10' width='44' height='8' rx='4' fill='#7FD1C6' />
                    <rect x='6' y='24' width='44' height='8' rx='4' fill='#7FD1C6' opacity='0.6' />
                    <rect x='6' y='38' width='28' height='8' rx='4' fill='#0E7490' />
                </svg>
                <Box style={{ flex: 1 }}>
                    <Text style={{ fontSize: 22, fontWeight: '600', color: '#1F2937' }}>数据发布分散，难以横向阅读</Text>
                    <Text style={{ fontSize: 16, color: '#64748B', marginTop: '6px', lineHeight: 1.5 }}>官方平台按城市、按日发布，想看"哪座城市更差"只能反复翻页，趋势全靠肉眼拼</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: '24px', background: '#FFFFFF', borderRadius: '12px', padding: '0 28px', boxShadow: '0 4px 20px rgba(14,116,144,0.08)' }}>
                <svg width='56' height='56' viewBox='0 0 56 56'>
                    <rect x='8' y='26' width='10' height='22' rx='3' fill='#0E7490' />
                    <rect x='23' y='16' width='10' height='32' rx='3' fill='#7FD1C6' />
                    <rect x='38' y='8' width='10' height='40' rx='3' fill='#F59E0B' />
                </svg>
                <Box style={{ flex: 1 }}>
                    <Text style={{ fontSize: 22, fontWeight: '600', color: '#1F2937' }}>多城对比、时段平均都要自己算</Text>
                    <Text style={{ fontSize: 16, color: '#64748B', marginTop: '6px', lineHeight: 1.5 }}>缺少"某个时间段内各城市平均值"的现成视图，得先下载表格再手动统计</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: '24px', background: '#FFFFFF', borderRadius: '12px', padding: '0 28px', boxShadow: '0 4px 20px rgba(14,116,144,0.08)' }}>
                <svg width='56' height='56' viewBox='0 0 56 56'>
                    <circle cx='28' cy='28' r='20' fill='none' stroke='#E2E8F0' strokeWidth='8' />
                    <path d='M28 8 A20 20 0 0 1 48 28' fill='none' stroke='#0E7490' strokeWidth='8' strokeLinecap='round' />
                    <path d='M48 28 A20 20 0 0 1 28 48' fill='none' stroke='#7FD1C6' strokeWidth='8' strokeLinecap='round' />
                </svg>
                <Box style={{ flex: 1 }}>
                    <Text style={{ fontSize: 22, fontWeight: '600', color: '#1F2937' }}>AQI 与六项污染物口径容易算错</Text>
                    <Text style={{ fontSize: 16, color: '#64748B', marginTop: '6px', lineHeight: 1.5 }}>各污染物分段标准不同、AQI 取最大值，手算极易出错，需要统一到国标 HJ 633-2012</Text>
                </Box>
            </Box>
        </Box>
    </Box>

    <Box style={{ height: '40px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#94A3B8' }}>城市空气质量监测看板</Text>
        <Text style={{ fontSize: 14, color: '#94A3B8' }}>02 / 07</Text>
    </Box>
</Slide>
