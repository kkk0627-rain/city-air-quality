<Slide style={{ padding: '20px 70px', background: '#F4F9FA' }}>
    <Box style={{ height: '110px', justifyContent: 'center' }}>
        <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#0E7490', lineHeight: 1.3 }}>成果演示与数据发现</Text>
        <Box style={{ width: '56px', height: '4px', background: '#7FD1C6', marginTop: '12px' }} />
    </Box>

    <Box style={{ height: '280px', background: '#FFFFFF', borderRadius: '14px', padding: '14px', boxShadow: '0 4px 20px rgba(14,116,144,0.08)' }}>
        <svg width='1112' height='252' viewBox='0 0 1112 252'>
            <rect x='0' y='0' width='1112' height='34' rx='6' fill='#0E7490' />
            <text x='18' y='23' font-size='15' fill='#FFFFFF' font-weight='bold'>城市空气质量监测看板</text>
            <text x='980' y='23' font-size='12' fill='#B8E6E0'>数据截止 2025-12-31</text>

            <rect x='0' y='44' width='248' height='208' rx='8' fill='#F4F9FA' />
            <text x='16' y='68' font-size='13' fill='#0E7490' font-weight='bold'>筛选区</text>
