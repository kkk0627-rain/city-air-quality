            <text x='26' y='97' font-size='12' fill='#64748B'>城市（多选）北京 ×　上海 ×</text>
            <rect x='16' y='114' width='216' height='26' rx='5' fill='#FFFFFF' stroke='#D9E5E8' />
            <text x='26' y='131' font-size='12' fill='#64748B'>2025-12-02　~　2025-12-31</text>
            <rect x='16' y='148' width='216' height='26' rx='5' fill='#FFFFFF' stroke='#D9E5E8' />
            <text x='26' y='165' font-size='12' fill='#64748B'>指标：AQI</text>
            <rect x='16' y='190' width='216' height='30' rx='6' fill='#0E7490' />
            <text x='86' y='210' font-size='13' fill='#FFFFFF'>查询</text>

            <rect x='260' y='44' width='530' height='112' rx='8' fill='#F4F9FA' />
            <text x='276' y='66' font-size='12' fill='#0E7490' font-weight='bold'>趋势折线</text>
            <polyline points='276,142 320,120 364,128 408,104 452,112 496,88 540,96 584,74 628,84 672,66 716,78 760,60' fill='none' stroke='#0E7490' stroke-width='2.5' />
            <polyline points='276,150 320,138 364,132 408,124 452,120 496,116 540,104 584,108 628,100 672,96 716,92 760,88' fill='none' stroke='#7FD1C6' stroke-width='2.5' />

            <rect x='802' y='44' width='310' height='112' rx='8' fill='#F4F9FA' />
            <text x='818' y='66' font-size='12' fill='#0E7490' font-weight='bold'>城市对比柱状</text>
            <rect x='818' y='98' width='34' height='44' rx='4' fill='#0E7490' />
            <rect x='862' y='84' width='34' height='58' rx='4' fill='#7FD1C6' />
            <rect x='906' y='108' width='34' height='34' rx='4' fill='#F59E0B' />
            <rect x='950' y='76' width='34' height='66' rx='4' fill='#0E7490' />
            <rect x='994' y='92' width='34' height='50' rx='4' fill='#7FD1C6' />

            <rect x='260' y='166' width='310' height='86' rx='8' fill='#F4F9FA' />
            <text x='276' y='188' font-size='12' fill='#0E7490' font-weight='bold'>等级分布环形</text>
            <circle cx='330' cy='222' r='26' fill='none' stroke='#E2E8F0' stroke-width='12' />
            <path d='M330 196 A26 26 0 0 1 356 222' fill='none' stroke='#4CAF50' stroke-width='12' />
            <path d='M356 222 A26 26 0 0 1 330 248' fill='none' stroke='#EAB308' stroke-width='12' />
            <path d='M330 248 A26 26 0 0 1 304 222' fill='none' stroke='#FF7E00' stroke-width='12' />
            <text x='380' y='212' font-size='12' fill='#64748B'>优 44%</text>
            <text x='380' y='230' font-size='12' fill='#64748B'>良 45%</text>
            <text x='470' y='212' font-size='12' fill='#64748B'>轻度 9%</text>

            <rect x='582' y='166' width='530' height='86' rx='8' fill='#F4F9FA' />
            <text x='598' y='188' font-size='12' fill='#0E7490' font-weight='bold'>数据详情表格</text>
            <rect x='598' y='198' width='498' height='18' rx='3' fill='#E6F6F5' />
            <text x='606' y='211' font-size='11' fill='#0E7490'>城市　　日期　　　　AQI　等级</text>
            <text x='606' y='229' font-size='11' fill='#64748B'>北京　2025-12-31　19　优</text>
            <text x='606' y='245' font-size='11' fill='#64748B'>郑州　2025-12-31　52　良</text>
