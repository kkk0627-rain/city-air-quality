<Slide style={{ padding: '20px 70px', background: '#F4F9FA' }}>
    <Box style={{ height: '110px', justifyContent: 'center' }}>
        <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#0E7490', lineHeight: 1.3 }}>系统设计与技术架构</Text>
        <Box style={{ width: '56px', height: '4px', background: '#7FD1C6', marginTop: '12px' }} />
    </Box>

    <Box style={{ height: '510px', flexDirection: 'row', gap: '32px' }}>
        <Box style={{ width: '700px', background: '#FFFFFF', borderRadius: '14px', padding: '16px 22px', boxShadow: '0 4px 20px rgba(14,116,144,0.08)' }}>
            <Text style={{ fontSize: 17, fontWeight: '600', color: '#1F2937' }}>五层架构：每层职责单一，可单独替换</Text>
            <svg width='656' height='424' viewBox='0 0 656 424'>
                <rect x='0' y='4' width='656' height='74' rx='10' fill='#E6F6F5' />
                <rect x='0' y='4' width='6' height='74' rx='3' fill='#0E7490' />
                <text x='22' y='34' font-size='17' font-weight='bold' fill='#0E7490'>前端展示层</text>
                <text x='22' y='58' font-size='14' fill='#64748B'>Vue 3 组件 + ECharts：趋势折线 · 对比柱状 · 等级环形 · 分页表格</text>
                <path d='M328 78 L328 92' stroke='#94A3B8' stroke-width='2' />
                <path d='M324 88 L328 94 L332 88' fill='none' stroke='#94A3B8' stroke-width='2' />

                <rect x='0' y='94' width='656' height='74' rx='10' fill='#E6F6F5' />
                <rect x='0' y='94' width='6' height='74' rx='3' fill='#0E7490' />
                <text x='22' y='124' font-size='17' font-weight='bold' fill='#0E7490'>接口层 Controller</text>
                <text x='22' y='148' font-size='14' fill='#64748B'>{'GET /api/cities · /api/air-quality · /stats · /{id}'}</text>
                <path d='M328 168 L328 182' stroke='#94A3B8' stroke-width='2' />
                <path d='M324 178 L328 184 L332 178' fill='none' stroke='#94A3B8' stroke-width='2' />

                <rect x='0' y='184' width='656' height='74' rx='10' fill='#E6F6F5' />
                <rect x='0' y='184' width='6' height='74' rx='3' fill='#0E7490' />
                <text x='22' y='214' font-size='17' font-weight='bold' fill='#0E7490'>业务层 Service</text>
                <text x='22' y='238' font-size='14' fill='#64748B'>AQI 国标换算 · 等级判定 · 分组统计 · 分页与参数校验</text>
                <path d='M328 258 L328 272' stroke='#94A3B8' stroke-width='2' />
                <path d='M324 268 L328 274 L332 268' fill='none' stroke='#94A3B8' stroke-width='2' />

                <rect x='0' y='274' width='656' height='74' rx='10' fill='#E6F6F5' />
                <rect x='0' y='274' width='6' height='74' rx='3' fill='#0E7490' />
                <text x='22' y='304' font-size='17' font-weight='bold' fill='#0E7490'>数据访问层 Mapper</text>
                <text x='22' y='328' font-size='14' fill='#64748B'>MyBatis XML：全部走 uk_city_date / idx_date 索引直查，无 GROUP BY</text>
                <path d='M328 348 L328 362' stroke='#94A3B8' stroke-width='2' />
                <path d='M324 358 L328 364 L332 358' fill='none' stroke='#94A3B8' stroke-width='2' />

                <rect x='0' y='364' width='656' height='56' rx='10' fill='#0E7490' />
                <text x='22' y='388' font-size='17' font-weight='bold' fill='#FFFFFF'>MySQL 8 · aqi_dashboard</text>
                <text x='22' y='408' font-size='14' fill='#B8E6E0'>city 12 行　air_quality 4,332 行　唯一键 uk_city_date</text>
            </svg>
        </Box>

        <Box style={{ flex: 1, justifyContent: 'space-between' }}>
            <Box style={{ height: '118px', flexShrink: 0, background: '#FFFFFF', borderRadius: '12px', padding: '20px 22px', justifyContent: 'center', boxShadow: '0 4px 20px rgba(14,116,144,0.08)' }}>
                <Text style={{ fontSize: 20, fontWeight: '600', color: '#0E7490' }}>聚合下沉 Java 侧</Text>
                <Text style={{ fontSize: 15, color: '#64748B', marginTop: '8px', lineHeight: 1.55 }}>4,332 行规模下内存聚合开销可忽略，借此避免在 XML 里拼接列名</Text>
            </Box>
            <Box style={{ height: '118px', flexShrink: 0, background: '#FFFFFF', borderRadius: '12px', padding: '20px 22px', justifyContent: 'center', boxShadow: '0 4px 20px rgba(14,116,144,0.08)' }}>
                <Text style={{ fontSize: 20, fontWeight: '600', color: '#0E7490' }}>HALF_EVEN 舍入</Text>
                <Text style={{ fontSize: 15, color: '#64748B', marginTop: '8px', lineHeight: 1.55 }}>对齐国标与清洗脚本，全量 4,332 行复算与入库值零偏差</Text>
            </Box>
            <Box style={{ height: '118px', flexShrink: 0, background: '#FFFFFF', borderRadius: '12px', padding: '20px 22px', justifyContent: 'center', boxShadow: '0 4px 20px rgba(14,116,144,0.08)' }}>
                <Text style={{ fontSize: 20, fontWeight: '600', color: '#0E7490' }}>CORS 白名单</Text>
                <Text style={{ fontSize: 15, color: '#64748B', marginTop: '8px', lineHeight: 1.55 }}>只放行 localhost:5173，其余来源一律拒绝，不图省事开通配</Text>
            </Box>
            <Box style={{ height: '118px', flexShrink: 0, background: '#FFFFFF', borderRadius: '12px', padding: '20px 22px', justifyContent: 'center', boxShadow: '0 4px 20px rgba(14,116,144,0.08)' }}>
                <Text style={{ fontSize: 20, fontWeight: '600', color: '#0E7490' }}>日期边界由 /meta 下发</Text>
                <Text style={{ fontSize: 15, color: '#64748B', marginTop: '8px', lineHeight: 1.55 }}>数据集"今天"是 2025-12-31，不用系统时间，避免默认落在空区间</Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ height: '40px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#94A3B8' }}>城市空气质量监测看板</Text>
        <Text style={{ fontSize: 14, color: '#94A3B8' }}>04 / 07</Text>
    </Box>
</Slide>
