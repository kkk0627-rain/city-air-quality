<Slide style={{ padding: '20px 70px', background: '#F4F9FA' }}>
    <Box style={{ height: '110px', justifyContent: 'center' }}>
        <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#0E7490', lineHeight: 1.3 }}>功能与接口实现</Text>
        <Box style={{ width: '56px', height: '4px', background: '#7FD1C6', marginTop: '12px' }} />
    </Box>

    <Box style={{ height: '510px', flexDirection: 'row', gap: '32px' }}>
        <Box style={{ width: '340px', background: 'linear-gradient(135deg, #0E7490 0%, #7FD1C6 100%)', borderRadius: '14px', padding: '22px 24px', justifyContent: 'space-between' }}>
            <Box>
                <Text style={{ fontSize: 18, color: '#B8E6E0', fontWeight: '600', letterSpacing: 2 }}>API</Text>
                <Text style={{ fontSize: 26, color: '#FFFFFF', fontWeight: 'bold', marginTop: '14px', lineHeight: 1.4 }}>四个后端接口</Text>
            </Box>
            <Box>
                <Text style={{ fontSize: 16, color: '#FFFFFF', lineHeight: 1.9, fontWeight: '600' }}>{'A1　GET /api/cities'}</Text>
                <Text style={{ fontSize: 14, color: '#D6EEEC', lineHeight: 1.6, marginBottom: '4px' }}>城市列表，含城市名与城市代码</Text>
                <Text style={{ fontSize: 16, color: '#FFFFFF', lineHeight: 1.9, fontWeight: '600' }}>{'A2　GET /api/air-quality'}</Text>
                <Text style={{ fontSize: 14, color: '#D6EEEC', lineHeight: 1.6, marginBottom: '4px' }}>城市 + 指标 + 起止日期，分页返回明细</Text>
                <Text style={{ fontSize: 16, color: '#FFFFFF', lineHeight: 1.9, fontWeight: '600' }}>{'A3　GET /api/air-quality/stats'}</Text>
                <Text style={{ fontSize: 14, color: '#D6EEEC', lineHeight: 1.6, marginBottom: '4px' }}>按城市分组：均值 / 最大 / 最小 / 优良率</Text>
                <Text style={{ fontSize: 16, color: '#FFFFFF', lineHeight: 1.9, fontWeight: '600' }}>{'A4　GET /api/air-quality/{id}'}</Text>
                <Text style={{ fontSize: 14, color: '#D6EEEC', lineHeight: 1.6 }}>单条记录全部字段详情</Text>
            </Box>
            <Box style={{ background: 'rgba(255,255,255,0.14)', borderRadius: '10px', padding: '14px 16px' }}>
                <Text style={{ fontSize: 13, color: '#B8E6E0', lineHeight: 1.6 }}>参数示例</Text>
                <Text style={{ fontSize: 13, color: '#FFFFFF', lineHeight: 1.6, marginTop: '6px', fontFamily: 'Arial' }}>{'?cityIds=1,2&metric=pm25'}<br />{'&start=2025-01-01&end=2025-01-31'}</Text>
            </Box>
        </Box>

        <Box style={{ flex: 1, flexDirection: 'row', gap: '20px' }}>
            <Box style={{ flex: 1, justifyContent: 'space-between' }}>
                <Box style={{ height: '112px', background: '#FFFFFF', borderRadius: '12px', padding: '18px 20px', justifyContent: 'center', boxShadow: '0 4px 20px rgba(14,116,144,0.08)' }}>
                    <Text style={{ fontSize: 19, fontWeight: '600', color: '#0E7490' }}>F1　首页框架</Text>
                    <Text style={{ fontSize: 15, color: '#64748B', marginTop: '6px', lineHeight: 1.5 }}>顶部标题栏 + 左侧筛选区 + 主区图表</Text>
                </Box>
                <Box style={{ height: '112px', background: '#FFFFFF', borderRadius: '12px', padding: '18px 20px', justifyContent: 'center', boxShadow: '0 4px 20px rgba(14,116,144,0.08)' }}>
                    <Text style={{ fontSize: 19, fontWeight: '600', color: '#0E7490' }}>F2　城市选择</Text>
                    <Text style={{ fontSize: 15, color: '#64748B', marginTop: '6px', lineHeight: 1.5 }}>12 城可多选，支持全选与一键清空</Text>
                </Box>
                <Box style={{ height: '112px', background: '#FFFFFF', borderRadius: '12px', padding: '18px 20px', justifyContent: 'center', boxShadow: '0 4px 20px rgba(14,116,144,0.08)' }}>
                    <Text style={{ fontSize: 19, fontWeight: '600', color: '#0E7490' }}>F3　时间范围</Text>
                    <Text style={{ fontSize: 15, color: '#64748B', marginTop: '6px', lineHeight: 1.5 }}>起止日期选择，默认展示最近 30 天</Text>
                </Box>
                <Box style={{ height: '112px', background: '#FFFFFF', borderRadius: '12px', padding: '18px 20px', justifyContent: 'center', boxShadow: '0 4px 20px rgba(14,116,144,0.08)' }}>
                    <Text style={{ fontSize: 19, fontWeight: '600', color: '#0E7490' }}>F4　指标切换</Text>
                    <Text style={{ fontSize: 15, color: '#64748B', marginTop: '6px', lineHeight: 1.5 }}>AQI / PM2.5 / PM10 / SO₂ / NO₂ / CO / O₃</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, justifyContent: 'space-between' }}>
                <Box style={{ height: '112px', background: '#FFFFFF', borderRadius: '12px', padding: '18px 20px', justifyContent: 'center', boxShadow: '0 4px 20px rgba(14,116,144,0.08)' }}>
                    <Text style={{ fontSize: 19, fontWeight: '600', color: '#0E7490' }}>F5　趋势折线</Text>
                    <Text style={{ fontSize: 15, color: '#64748B', marginTop: '6px', lineHeight: 1.5 }}>多城市同图对比，随日期与指标联动</Text>
                </Box>
                <Box style={{ height: '112px', background: '#FFFFFF', borderRadius: '12px', padding: '18px 20px', justifyContent: 'center', boxShadow: '0 4px 20px rgba(14,116,144,0.08)' }}>
                    <Text style={{ fontSize: 19, fontWeight: '600', color: '#0E7490' }}>F6　对比柱状</Text>
                    <Text style={{ fontSize: 15, color: '#64748B', marginTop: '6px', lineHeight: 1.5 }}>时段内各城市平均浓度横向对比</Text>
                </Box>
                <Box style={{ height: '112px', background: '#FFFFFF', borderRadius: '12px', padding: '18px 20px', justifyContent: 'center', boxShadow: '0 4px 20px rgba(14,116,144,0.08)' }}>
                    <Text style={{ fontSize: 19, fontWeight: '600', color: '#0E7490' }}>F7　等级环形</Text>
                    <Text style={{ fontSize: 15, color: '#64748B', marginTop: '6px', lineHeight: 1.5 }}>优 / 良 / 轻度 / 中度 / 重度 / 严重天数占比</Text>
                </Box>
                <Box style={{ height: '112px', background: '#FFFFFF', borderRadius: '12px', padding: '18px 20px', justifyContent: 'center', boxShadow: '0 4px 20px rgba(14,116,144,0.08)' }}>
                    <Text style={{ fontSize: 19, fontWeight: '600', color: '#0E7490' }}>F8　明细表格</Text>
                    <Text style={{ fontSize: 15, color: '#64748B', marginTop: '6px', lineHeight: 1.5 }}>当前筛选下原始数据，分页每页 10 条</Text>
                </Box>
            </Box>
        </Box>
    </Box>

    <Box style={{ height: '40px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#64748B' }}>AQI 按 HJ 633-2012 取六项 IAQI 最大值　|　46 项自动化测试全部通过，含 4,332 行全量交叉校验零偏差</Text>
        <Text style={{ fontSize: 14, color: '#94A3B8' }}>05 / 07</Text>
    </Box>
</Slide>
